# Copy this file to .env and fill in your real Groq API key.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model to use for matching.
# Default: openai/gpt-oss-20b (available on Groq, supports JSON output)
# Other options: openai/gpt-oss-120b, qwen/qwen3.8-27b, groq/compound
GROQ_MODEL=openai/gpt-oss-20b

APP_ENV=development
REQUEST_TIMEOUT_SECONDS=30.0
